@model IEnumerable<MyExpenseTracker.Models.Expense>
@using System.Globalization

@{
    ViewData["Title"] = "Filter Expenses";
}


<div class="container mt-4">
    <h2 class="text-center mb-4">Filter Expenses by Month and Year</h2>

    <!-- Filter Form -->
    <form method="post" action="@Url.Action("FilterExpensesByMonthYear", "Expense")" class="row g-3 justify-content-center">
        <div class="col-md-4">
            <label for="month" class="form-label">Select Month</label>
            <select name="month" id="month" class="form-select">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label for="year" class="form-label">Select Year</label>
            <select name="year" id="year" class="form-select">
                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 10; y++)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filter Expenses</button>
        </div>
    </form>

    <!-- Expenses Table -->
    <div class="mt-4">
        @if (Model != null && Model.Any())
        {
            <h3 class="text-center">Expenses List</h3>
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Label</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model)
                        {
                            <tr>
                                <td>@expense.Date.ToString("yyyy-MM-dd")</td>
                                <td>@expense.Category</td>
                                <td>@expense.Amount.ToString("C")</td>
                                <td>@expense.Description</td>
                                <td>@expense.Label</td>
                                <td>
                                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@expense.Id">Edit</a>
                                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@expense.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center mt-3 text-muted">No expenses found for the selected month and year.</p>
        }
    </div>
</div>

